+        let n = |key: &str| work.fields.0[key].parse::<usize>().unwrap();
+        assert!(n("retained_bytes") <= n("budget_bytes"));
+        assert!(n("subscriptions") <= super::beads_db::DEFAULT_READER_THREADS);
