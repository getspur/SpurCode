+        [],
+    )
+    .unwrap();
+    conn.execute(
+        "UPDATE issues SET assignee = NULL, is_template = NULL WHERE id = 'bd-0-1'",
+        [],
+    )
+    .unwrap();
+    (dir, adapter, conn)
