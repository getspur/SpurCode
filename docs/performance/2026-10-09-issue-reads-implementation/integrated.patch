+fn fixture() -> (tempfile::TempDir, Connection, IssueChangeFeed) {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("beads.db");
+    drop(beads_rust::storage::sqlite::SqliteStorage::open(&path).unwrap());
