+//! Shared notebook normalization. Original decoded source owns all coordinates.
+
+use std::collections::HashMap;
+
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+
+use super::languages::Language;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum NotebookStatus {
+    Complete,
+    Partial,
+    Invalid,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CellIdentityQuality {
+    Explicit,
+    SourceDerived,
+    Ambiguous,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum NotebookDiagnosticCode {
+    InvalidJson,
+    InvalidNotebook,
+    InvalidCells,
+    InvalidCell,
+    InvalidCellType,
+    InvalidCellId,
+    InvalidSource,
+    InvalidMetadata,
+    DuplicateEffectiveId,
+    SourceDerivedIdentity,
+    RepeatedAnonymousSource,
+    UnsupportedLanguage,
+    UnsupportedRustCommand,
+    UnsupportedRustDependency,
+    NonLeadingRustDirective,
+    UnsupportedPythonMagic,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct NotebookDiagnostic {
+    pub code: NotebookDiagnosticCode,
+    pub cell_ordinal: Option<usize>,
+    /// Half-open UTF-8 byte range in the decoded cell, when applicable.
+    pub byte_range: Option<[usize; 2]>,
+    pub message: String,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SourceCoordinateMap {
+    Identity,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DependencyDirective {
+    pub text: String,
+    pub byte_range: [usize; 2],
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PreparedSource {
+    pub original: String,
+    pub original_sha256: String,
+    pub analysis: String,
+    pub analysis_sha256: String,
+    pub policy: &'static str,
+    pub coordinate_map: SourceCoordinateMap,
+    pub directives: Vec<DependencyDirective>,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct NormalizedCell {
+    pub id: String,
+    pub identity_quality: CellIdentityQuality,
+    pub ordinal: usize,
+    pub cell_type: Option<String>,
+    pub language: Option<Language>,
+    pub metadata: Value,
+    /// None for invalid source shapes; never a silently filtered fragment.
+    pub source: Option<PreparedSource>,
+    pub status: NotebookStatus,
+    pub diagnostics: Vec<NotebookDiagnostic>,
+}
+
+impl NormalizedCell {
+    pub fn identity_path(&self, notebook_path: &str) -> String {
+        format!("{notebook_path}#cell:{}", self.id)
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct NormalizedNotebook {
+    /// SHA256 of the exact input bytes, including the notebook JSON wrapper.
+    pub source_sha256: String,
+    pub metadata: Value,
+    pub cells: Vec<NormalizedCell>,
+    pub status: NotebookStatus,
+    pub diagnostics: Vec<NotebookDiagnostic>,
+}
+
+/// Bounded notebook-only preparation; never executes commands or reads targets.
+pub const RUST_PREPARATION_POLICY: &str = "evcxr-leading-dep-mask-v1";
+
+/// Decode every cell without losing invalid/unsupported inventory. A complete
+/// extraction status does not establish runtime compatibility or stable identity
+/// across edits to anonymous cells; inspect identity quality and diagnostics too.
+pub fn normalize_notebook(bytes: &[u8]) -> NormalizedNotebook {
+    let mut notebook = NormalizedNotebook {
+        source_sha256: sha256(bytes),
+        metadata: Value::Null,
+        cells: Vec::new(),
+        status: NotebookStatus::Complete,
+        diagnostics: Vec::new(),
+    };
+    let root: Value = match serde_json::from_slice(bytes) {
+        Ok(root) => root,
+        Err(error) => {
+            notebook.diagnostics.push(diagnostic(
+                NotebookDiagnosticCode::InvalidJson,
+                None,
+                None,
+                error.to_string(),
+            ));
+            notebook.status = NotebookStatus::Invalid;
+            return notebook;
+        }
+    };
+    if !root.is_object() {
+        notebook.diagnostics.push(diagnostic(
+            NotebookDiagnosticCode::InvalidNotebook,
+            None,
+            None,
+            "notebook must be an object",
+        ));
+        notebook.status = NotebookStatus::Invalid;
+        return notebook;
+    }
+    notebook.metadata = root.get("metadata").cloned().unwrap_or(Value::Null);
+    if root.get("metadata").is_some_and(|meta| !meta.is_object()) {
+        notebook.diagnostics.push(diagnostic(
+            NotebookDiagnosticCode::InvalidMetadata,
+            None,
+            None,
+            "root metadata must be an object",
+        ));
+        notebook.status = NotebookStatus::Invalid;
+    }
+    let Some(cells) = root.get("cells").and_then(Value::as_array) else {
+        notebook.diagnostics.push(diagnostic(
+            NotebookDiagnosticCode::InvalidCells,
+            None,
+            None,
+            "cells must be an array",
+        ));
+        notebook.status = NotebookStatus::Invalid;
+        return notebook;
+    };
+    let mut anonymous: HashMap<String, Vec<usize>> = HashMap::new();
+    let mut effective_ids: HashMap<String, Vec<usize>> = HashMap::new();
+    for (ordinal, value) in cells.iter().enumerate() {
+        let mut cell = NormalizedCell {
+            id: String::new(),
+            identity_quality: CellIdentityQuality::Explicit,
+            ordinal,
+            cell_type: value
+                .get("cell_type")
+                .and_then(Value::as_str)
+                .map(str::to_owned),
+            language: None,
+            metadata: value.get("metadata").cloned().unwrap_or(Value::Null),
+            source: None,
+            status: NotebookStatus::Complete,
+            diagnostics: Vec::new(),
+        };
+        if !value.is_object() {
+            cell.add_diagnostic(
+                NotebookDiagnosticCode::InvalidCell,
+                None,
+                "cell must be an object",
+                NotebookStatus::Invalid,
+            );
+        }
+        match cell.cell_type.as_deref() {
+            Some("code") => {
+                cell.language = super::notebook::resolve_cell_language(value, &root);
+                if cell.language.is_none() {
+                    cell.add_diagnostic(
+                        NotebookDiagnosticCode::UnsupportedLanguage,
+                        None,
+                        "no supported notebook language",
+                        NotebookStatus::Partial,
+                    );
+                }
+            }
+            _ if super::notebook::cell_is_markdown(value) => {
+                cell.language = Some(Language::Markdown)
+            }
+            Some("raw") => {}
+            _ => cell.add_diagnostic(
+                NotebookDiagnosticCode::InvalidCellType,
+                None,
+                "cell_type must be code, markdown or raw",
+                NotebookStatus::Invalid,
+            ),
+        }
+        if value.get("metadata").is_some_and(|meta| !meta.is_object()) {
+            cell.add_diagnostic(
+                NotebookDiagnosticCode::InvalidMetadata,
+                None,
+                "cell metadata must be an object",
+                NotebookStatus::Invalid,
+            );
+        }
+        let original = match value.get("source") {
+            Some(Value::String(text)) => Some(text.clone()),
+            Some(Value::Array(parts)) => {
+                parts.iter().map(Value::as_str).collect::<Option<String>>()
+            }
+            _ => None,
+        };
+        if let Some(original) = original {
+            cell.source = Some(PreparedSource {
+                original_sha256: sha256(original.as_bytes()),
+                analysis_sha256: sha256(original.as_bytes()),
+                analysis: original.clone(),
+                original,
+                policy: "identity-v1",
+                coordinate_map: SourceCoordinateMap::Identity,
+                directives: Vec::new(),
+            });
+        } else {
+            cell.add_diagnostic(
+                NotebookDiagnosticCode::InvalidSource,
+                None,
+                "source must be a string or an array of strings",
+                NotebookStatus::Invalid,
+            );
+        }
+        if let Some(id) = value
+            .get("id")
+            .and_then(Value::as_str)
+            .map(str::trim)
+            .filter(|id| !id.is_empty())
+        {
+            cell.id = id.to_owned();
+        } else {
+            if value.get("id").is_some() {
+                cell.add_diagnostic(
+                    NotebookDiagnosticCode::InvalidCellId,
+                    None,
+                    "explicit cell id must be a nonblank string",
+                    NotebookStatus::Invalid,
+                );
+            }
+            // Preserve the existing BLAKE3 decoded-source/occurrence convention.
+            let source = cell
+                .source
+                .as_ref()
+                .map(|p| p.original.as_str())
+                .unwrap_or("");
+            let base = format!("cell-{}", blake3::hash(source.as_bytes()).to_hex());
+            let occurrences = anonymous.entry(base.clone()).or_default();
+            occurrences.push(ordinal);
+            cell.id = if occurrences.len() == 1 {
+                base
+            } else {
+                format!("{base}-{}", occurrences.len())
+            };
+            cell.identity_quality = CellIdentityQuality::SourceDerived;
+            cell.add_diagnostic(NotebookDiagnosticCode::SourceDerivedIdentity, None, "anonymous identity changes with decoded source; repeated sources depend on occurrence order", NotebookStatus::Complete);
+        }
+        effective_ids
+            .entry(cell.id.clone())
+            .or_default()
+            .push(ordinal);
+        prepare_cell(&mut cell);
+        notebook.cells.push(cell);
+    }
+    for ordinals in anonymous.values().filter(|items| items.len() > 1) {
+        for &ordinal in ordinals {
+            notebook.cells[ordinal].add_diagnostic(
+                NotebookDiagnosticCode::RepeatedAnonymousSource,
+                None,
+                "repeated anonymous source has occurrence-sensitive identity",
+                NotebookStatus::Partial,
+            );
+        }
+    }
+    // One namespace across explicit IDs, anonymous hashes and occurrence suffixes.
+    for ordinals in effective_ids.values().filter(|items| items.len() > 1) {
+        for &ordinal in ordinals {
+            let cell = &mut notebook.cells[ordinal];
+            cell.identity_quality = CellIdentityQuality::Ambiguous;
+            cell.add_diagnostic(
+                NotebookDiagnosticCode::DuplicateEffectiveId,
+                None,
+                "effective cell id is not unique",
+                NotebookStatus::Invalid,
+            );
+        }
+    }
+    for cell in &notebook.cells {
+        notebook.status = merge_status(notebook.status, cell.status);
+    }
+    notebook
+}
+
+impl NormalizedCell {
+    fn add_diagnostic(
+        &mut self,
+        code: NotebookDiagnosticCode,
+        range: Option<[usize; 2]>,
+        message: &str,
+        status: NotebookStatus,
+    ) {
+        self.diagnostics
+            .push(diagnostic(code, Some(self.ordinal), range, message));
+        self.status = merge_status(self.status, status);
+    }
+}
+
+fn diagnostic(
+    code: NotebookDiagnosticCode,
+    cell_ordinal: Option<usize>,
+    byte_range: Option<[usize; 2]>,
+    message: impl Into<String>,
+) -> NotebookDiagnostic {
+    NotebookDiagnostic {
+        code,
+        cell_ordinal,
+        byte_range,
+        message: message.into(),
+    }
+}
+
+fn merge_status(left: NotebookStatus, right: NotebookStatus) -> NotebookStatus {
+    match (left, right) {
+        (NotebookStatus::Invalid, _) | (_, NotebookStatus::Invalid) => NotebookStatus::Invalid,
+        (NotebookStatus::Partial, _) | (_, NotebookStatus::Partial) => NotebookStatus::Partial,
+        _ => NotebookStatus::Complete,
+    }
+}
+
+fn sha256(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+fn prepare_cell(cell: &mut NormalizedCell) {
+    let Some(mut source) = cell.source.take() else {
+        return;
+    };
+    if cell.language == Some(Language::Rust) {
+        source.policy = RUST_PREPARATION_POLICY;
+        let mut analysis = source.original.as_bytes().to_vec();
+        let mut leading = true;
+        let mut lexer = RustLex::Code;
+        let mut start = 0;
+        for line in source.original.split_inclusive('\n') {
+            let text = line.trim_end_matches(['\r', '\n']);
+            let trimmed = text.trim_start();
+            if let Some(offset) = lexer.scan(line) {
+                let command = &text[offset..];
+                let range = [start + offset, start + text.len()];
+                let dep = command
+                    .strip_prefix(":dep")
+                    .filter(|rest| rest.is_empty() || rest.starts_with(char::is_whitespace));
+                if let Some(assignment) = dep {
+                    if !leading || !text[..offset].trim().is_empty() {
+                        cell.add_diagnostic(
+                            NotebookDiagnosticCode::NonLeadingRustDirective,
+                            Some(range),
+                            "dependency directives are supported only before code/comments",
+                            NotebookStatus::Partial,
+                        );
+                        leading = false;
+                    } else if single_line_dependency(assignment) {
+                        let range = [start, start + text.len()];
+                        for byte in &mut analysis[range[0]..range[1]] {
+                            if !matches!(*byte, b'\r' | b'\n') {
+                                *byte = b' ';
+                            }
+                        }
+                        source.directives.push(DependencyDirective {
+                            text: text.to_owned(),
+                            byte_range: range,
+                        });
+                    } else {
+                        cell.add_diagnostic(NotebookDiagnosticCode::UnsupportedRustDependency, Some(range), "only a single-line dependency assignment is supported; multiline/trailing forms remain unchanged", NotebookStatus::Partial);
+                        leading = false;
+                    }
+                } else {
+                    cell.add_diagnostic(
+                        NotebookDiagnosticCode::UnsupportedRustCommand,
+                        Some(range),
+                        "unsupported Rust kernel command; no command is executed or target read",
+                        NotebookStatus::Partial,
+                    );
+                    leading = false;
+                }
+            } else {
+                if !trimmed.is_empty() {
+                    leading = false;
+                }
+            }
+            start += line.len();
+        }
+        source.analysis = String::from_utf8(analysis).expect("ASCII space masking preserves UTF-8");
+        source.analysis_sha256 = sha256(source.analysis.as_bytes());
+    } else if cell.language == Some(Language::Python) {
+        let mut start = 0;
+        for line in source.original.split_inclusive('\n') {
+            let text = line.trim_end_matches(['\r', '\n']);
+            let trimmed = text.trim_start();
+            if !trimmed.is_empty() {
+                if trimmed.starts_with(['%', '!']) {
+                    cell.add_diagnostic(NotebookDiagnosticCode::UnsupportedPythonMagic, Some([start, start + text.len()]), "IPython magic/shell prefix is unsupported; saved Python metadata does not establish plain-Python coverage", NotebookStatus::Partial);
+                }
+                break;
+            }
+            start += line.len();
+        }
+    }
+    cell.source = Some(source);
+}
+
+fn single_line_dependency(assignment: &str) -> bool {
+    // TOML rejects unterminated strings/tables, continuations and trailing code.
+    // This is syntax validation only: no dependency resolution or filesystem I/O.
+    let Ok(table) = toml::from_str::<toml::Table>(assignment) else {
+        return false;
+    };
+    if table.len() != 1 {
+        return false;
+    }
+    let Some((name, value)) = table.iter().next() else {
+        return false;
+    };
+    if name.is_empty()
+        || !name
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_'))
+    {
+        return false;
+    }
+    value.is_str()
+        || value.as_table().is_some_and(|options| {
+            ["version", "git", "path"]
+                .iter()
+                .any(|key| options.get(*key).is_some_and(toml::Value::is_str))
+        })
+}
+
+/// A lexical boundary for command lines, not an Evcxr parser. Ordinary/byte/C
+/// strings share quote rules; raw and raw-byte strings share hash delimiters.
+/// Comments nest. Apostrophes enter a char token only with a definite closing
+/// quote, so lifetimes/labels never swallow a following command line.
+enum RustLex {
+    Code,
+    Quoted,
+    Raw(usize),
+    Block(usize),
+}
+
+impl RustLex {
+    fn scan(&mut self, line: &str) -> Option<usize> {
+        let bytes = line.as_bytes();
+        let mut i = 0;
+        let mut only_trivia = matches!(self, Self::Code | Self::Block(_));
+        while i < bytes.len() {
+            match self {
+                Self::Quoted => match bytes[i] {
+                    b'\\' => {
+                        i = (i + 2).min(bytes.len());
+                        continue;
+                    }
+                    b'"' => *self = Self::Code,
+                    _ => {}
+                },
+                Self::Raw(hashes) => {
+                    if bytes[i] == b'"'
+                        && bytes
+                            .get(i + 1..i + 1 + *hashes)
+                            .is_some_and(|tail| tail.iter().all(|b| *b == b'#'))
+                    {
+                        i += *hashes;
+                        *self = Self::Code;
+                    }
+                }
+                Self::Block(depth) => {
+                    if bytes[i..].starts_with(b"/*") {
+                        *depth += 1;
+                        i += 2;
+                        continue;
+                    }
+                    if bytes[i..].starts_with(b"*/") {
+                        *depth -= 1;
+                        if *depth == 0 {
+                            *self = Self::Code;
+                        }
+                        i += 2;
+                        continue;
+                    }
+                }
+                Self::Code => {
+                    if bytes[i..].starts_with(b"//") {
+                        break;
+                    }
+                    if bytes[i..].starts_with(b"/*") {
+                        *self = Self::Block(1);
+                        i += 2;
+                        continue;
+                    }
+                    if bytes[i] == b':'
+                        && bytes.get(i + 1) != Some(&b':')
+                        && (i == 0 || bytes[i - 1] != b':')
+                    {
+                        let tail = &line[i..];
+                        // Commands as the first lexical token (comments may
+                        // precede them), plus conservatively recognized inline
+                        // dependency/load forms. Never mask inline forms.
+                        let inline_command = [":dep", ":load"].iter().any(|name| {
+                            tail.strip_prefix(name).is_some_and(|rest| {
+                                rest.is_empty() || rest.starts_with(char::is_whitespace)
+                            })
+                        });
+                        if only_trivia || inline_command {
+                            return Some(i);
+                        }
+                    }
+                    if !bytes[i].is_ascii_whitespace() {
+                        only_trivia = false;
+                    }
+                    if bytes[i] == b'r' {
+                        let mut end = i + 1;
+                        while bytes.get(end) == Some(&b'#') {
+                            end += 1;
+                        }
+                        if bytes.get(end) == Some(&b'"') {
+                            *self = Self::Raw(end - i - 1);
+                            i = end + 1;
+                            continue;
+                        }
+                    }
+                    if bytes[i] == b'"' {
+                        *self = Self::Quoted;
+                    }
+                    if bytes[i] == b'\'' {
+                        if let Some(end) = char_literal_end(line, i) {
+                            i = end;
+                            continue;
+                        }
+                    }
+                }
+            }
+            i += 1;
+        }
+        None
+    }
+}
+
+fn char_literal_end(line: &str, start: usize) -> Option<usize> {
+    let bytes = line.as_bytes();
+    let first = line.get(start + 1..)?.chars().next()?;
+    if first != '\\' {
+        let end = start + 1 + first.len_utf8();
+        return (bytes.get(end) == Some(&b'\'')).then_some(end + 1);
+    }
+    let mut end = start + 1;
+    while end < bytes.len() {
+        match bytes[end] {
+            b'\r' | b'\n' => return None,
+            b'\\' => end += 2,
+            b'\'' => return Some(end + 1),
+            _ => end += 1,
+        }
+    }
+    None
+}
