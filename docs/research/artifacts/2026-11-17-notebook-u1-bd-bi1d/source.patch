+    #[test]
+    fn lifetime_apostrophes_do_not_hide_a_real_load_command() {
+        let source = "fn identity<'a>(x: &'a str) -> &'a str { x }\n:load other.rs\n";
+        let cell = rust(source);
+        assert_eq!(cell.status, NotebookStatus::Partial);
+        let diagnostic = cell
+            .diagnostics
+            .iter()
+            .find(|d| d.code == NotebookDiagnosticCode::UnsupportedRustCommand)
+            .expect("real :load after lifetimes must be diagnosed without reading its target");
+        let range = diagnostic.byte_range.unwrap();
+        assert_eq!(&source[range[0]..range[1]], ":load other.rs");
+        assert_eq!(cell.source.unwrap().analysis, source);
+    }
+
+    #[test]
+    fn raw_byte_strings_and_nested_block_comments_are_not_commands() {
+        for source in [
+            "let text = br##\"\n:load not_a_command.rs\n\"##;\nfn f() {}\n",
+            "/* outer /* inner */\n:load not_a_command.rs\n*/\nfn f() {}",
+        ] {
+            let cell = rust(source);
+            assert_eq!(
+                cell.status,
+                NotebookStatus::Complete,
+                "{:?}",
+                cell.diagnostics
+            );
+            assert!(cell.diagnostics.is_empty());
+            let prepared = cell.source.unwrap();
+            assert_eq!(prepared.original, source);
+            assert_eq!(prepared.analysis, source);
+            assert!(prepared.directives.is_empty());
+        }
+    }
+
+    #[test]
+    fn python_first_nonblank_magic_is_partial_but_literal_text_is_plain_python() {
+        for (source, unsupported) in [
+            ("\n  %%bash\necho hello\n", true),
+            ("%time value\n", true),
+            ("!ls\n", true),
+            ("text = '%%bash !ls %time'\ndef f():\n    pass\n", false),
+            (
+                "text = \"\"\"\n%%bash\n!ls\n\"\"\"\ndef f():\n    pass\n",
+                false,
+            ),
+        ] {
+            let metadata = json!({"spur":{"code_type":"python"},"profile":"saved"});
+            let nb = normalize(json!({"cells":[
+                {"id":"py","cell_type":"code","source":source,"metadata":metadata}
+            ]}));
+            assert_eq!(nb.cells.len(), 1);
+            let cell = &nb.cells[0];
+            assert_eq!(cell.metadata, metadata);
+            assert_eq!(cell.language, Some(Language::Python));
+            assert_eq!(cell.source.as_ref().unwrap().original, source);
+            assert_eq!(cell.source.as_ref().unwrap().analysis, source);
+            assert_eq!(
+                has(cell, NotebookDiagnosticCode::UnsupportedPythonMagic),
+                unsupported
+            );
+            let expected = if unsupported {
+                NotebookStatus::Partial
+            } else {
+                NotebookStatus::Complete
+            };
+            assert_eq!(cell.status, expected, "{source}");
+            assert_eq!(nb.status, expected, "{source}");
+        }
+    }
+
+    #[test]
+    fn rust_absolute_paths_are_code_and_inline_commands_are_partial() {
+        let absolute = "::std::mem::drop(value);\nfn f() {}\n";
+        let cell = rust(absolute);
+        assert_eq!(
+            cell.status,
+            NotebookStatus::Complete,
+            "{:?}",
+            cell.diagnostics
+        );
+        assert_eq!(cell.source.unwrap().analysis, absolute);
+        for (source, code) in [
+            (
+                "/* comment */ :dep serde = \"1\"\nfn f() {}",
+                NotebookDiagnosticCode::NonLeadingRustDirective,
+            ),
+            (
+                "/* comment */ :load other.rs\n",
+                NotebookDiagnosticCode::UnsupportedRustCommand,
+            ),
+            (
+                "fn f() {} :dep serde = \"1\"\n",
+                NotebookDiagnosticCode::NonLeadingRustDirective,
+            ),
+            (
+                "fn f() {} :load other.rs\n",
+                NotebookDiagnosticCode::UnsupportedRustCommand,
+            ),
+            (
+                ":dep\nfn f() {}",
+                NotebookDiagnosticCode::UnsupportedRustDependency,
+            ),
+        ] {
+            let cell = rust(source);
+            assert_eq!(cell.status, NotebookStatus::Partial, "{source}");
+            assert!(has(&cell, code), "{:?}", cell.diagnostics);
+            assert_eq!(cell.source.unwrap().analysis, source);
+        }
+    }
