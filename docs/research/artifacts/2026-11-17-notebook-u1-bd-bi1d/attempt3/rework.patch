+    #[test]
+    fn rust_real_commands_after_type_annotations_remain_partial() {
+        for command in [":dep serde = \"1\"", ":load /definitely/not/read.rs"] {
+            for body in [
+                "fn f(x:dep ) {}",
+                "fn f(x\n    :dep ) {}",
+                "fn f() { let value:dep = 1; }",
+            ] {
+                for separator in ["\n", " ", " /* boundary */ "] {
+                    let source = format!("type dep = i32;\n{body}{separator}{command}\n");
+                    let cell = rust(&source);
+                    assert_eq!(cell.status, NotebookStatus::Partial);
+                    assert_eq!(
+                        cell.diagnostics.len(),
+                        1,
+                        "{source}: {:?}",
+                        cell.diagnostics
+                    );
+                    let diagnostic = &cell.diagnostics[0];
+                    let range = diagnostic.byte_range.unwrap();
+                    assert_eq!(&source[range[0]..range[1]], command);
+                    let expected = if command.starts_with(":dep") {
+                        NotebookDiagnosticCode::NonLeadingRustDirective
+                    } else {
+                        NotebookDiagnosticCode::UnsupportedRustCommand
+                    };
+                    assert_eq!(diagnostic.code, expected);
+                    assert_eq!(cell.source.unwrap().analysis, source);
+                }
+            }
+        }
+    }
