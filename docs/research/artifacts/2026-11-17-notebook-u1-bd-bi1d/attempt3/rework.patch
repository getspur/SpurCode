+    #[test]
+    fn rust_dep_and_load_type_annotations_are_not_kernel_commands() {
+        let mut failures = Vec::new();
+        for body in [
+            "fn f(x:dep ) {}\n",
+            "fn f(x:load ) {}\n",
+            "fn f(x :dep ) {}\n",
+            "fn f(x :load ) {}\n",
+            "fn f(x: dep) {}\n",
+            "fn f(x: load) {}\n",
+            "struct S { value:dep }\n",
+            "struct S { value :load }\n",
+            "fn f() { let value:dep = 1; }\n",
+            "fn f() { let value :load = 1; }\n",
+            "const VALUE:dep = 1;\n",
+            "fn f() { let (x, y):load = (1, 2); }\n",
+            "fn f() { let S { value }:dep = s; }\n",
+        ] {
+            let alias = if body.contains("load") { "load" } else { "dep" };
+            let source = format!("type {alias} = i32;\n{body}");
+            let cell = rust(&source);
+            if cell.status != NotebookStatus::Complete || !cell.diagnostics.is_empty() {
+                failures.push(format!("{body:?}: {:?}", cell.diagnostics));
+            }
+            let prepared = cell.source.unwrap();
+            assert_eq!(prepared.original, source);
+            assert_eq!(prepared.analysis, source);
+            assert_eq!(prepared.original_sha256, prepared.analysis_sha256);
+            assert!(prepared.directives.is_empty());
+        }
+        assert!(failures.is_empty(), "{}", failures.join("\n"));
+    }
+
+    #[test]
+    fn rust_multiline_and_commented_type_annotations_are_not_kernel_commands() {
+        let mut failures = Vec::new();
+        for body in [
+            "fn f(x\n    :dep ) {}\n",
+            "fn f(x\n    :load ) {}\n",
+            "fn f(x /* before */ :dep /* after */ ) {}\n",
+            "fn f(x /* before */ :load /* after */ ) {}\n",
+            "fn f(x // before\n    :dep ) {}\n",
+            "fn f(x /* outer /* inner */\n    */ :load ) {}\n",
+            "struct S { value\n    :dep }\n",
+            "struct S { value /* before */ :load /* after */ }\n",
+            "fn f() { let value\n    :dep = 1; }\n",
+            "fn f() { let value // before\n    :load = 1; }\n",
+            "fn f() { let (x, y)\n    :dep = (1, 2); }\n",
+            "fn f() { let S { value } /* before */\n    :load = s; }\n",
+        ] {
+            let source = format!("type dep = i32;\ntype load = i32;\n{body}");
+            let cell = rust(&source);
+            if cell.status != NotebookStatus::Complete || !cell.diagnostics.is_empty() {
+                failures.push(format!("{body:?}: {:?}", cell.diagnostics));
+            }
+            let prepared = cell.source.unwrap();
+            assert_eq!(prepared.original, source);
+            assert_eq!(prepared.analysis, source);
+            assert_eq!(prepared.original_sha256, prepared.analysis_sha256);
+            assert!(prepared.directives.is_empty());
+        }
+        assert!(failures.is_empty(), "{}", failures.join("\n"));
+    }
