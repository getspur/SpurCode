     #[test]
+    fn normalized_notebook_input_errors_remain_recoverable() {
+        let mut parser = BytesExtractor::for_language(Language::JupyterNotebook).unwrap();
+        for source in ["", "not JSON", "{}", r#"{"cells":[{"cell_type":"code","source":[1]}]}"#] {
+            let error = parser.extract_file_facts(Path::new("bad.ipynb"), source.as_bytes())
+                .err().expect("malformed notebook must fail core extraction");
+            let message = error.to_string();
+            let result = diagnostic_error(error).expect("known notebook input error remains recoverable");
+            assert_eq!(result.status, "extraction_error");
+            assert_eq!(result.error_code.as_deref(), Some("malformed_input"));
+            assert_eq!(result.error_message.as_deref(), Some(message.as_str()));
+            assert!(result.facts.is_none());
+        }
+        for message in ["parse .ipynb JSON parser setup failed", "invalid .ipynb notebook infrastructure"] {
+            assert!(diagnostic_error(ExtractError::Extraction(message.into())).is_err());
+        }
+    }
