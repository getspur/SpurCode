+    fn assert_notebook_input_diagnostics(sources: &[&str], prefix: &str) {
+        let mut parser = BytesExtractor::for_language(Language::JupyterNotebook).unwrap();
+        for source in sources {
+            let error = parser
+                .extract_file_facts(Path::new("bad.ipynb"), source.as_bytes())
+                .err()
+                .expect("invalid notebook must fail core extraction");
+            assert!(
+                matches!(&error, ExtractError::Extraction(message) if message.starts_with(prefix)),
+                "{error}"
+            );
+            let message = error.to_string();
+            let result = diagnostic_error(error)
+                .expect("known core notebook input error must retain row diagnostics");
+            assert_eq!(result.status, "extraction_error");
+            assert_eq!(result.error_code.as_deref(), Some("malformed_input"));
+            assert_eq!(result.error_message.as_deref(), Some(message.as_str()));
+            assert!(result.facts.is_none());
+        }
+    }
