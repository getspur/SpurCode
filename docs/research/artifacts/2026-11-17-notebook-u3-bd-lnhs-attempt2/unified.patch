+                self.assertEqual(selected[i], 0)
+                self.assertEqual(diff['status'], 'invalid')
+                continue
+            self.assertEqual(sum(len(c['symbols']) for c in doc['cells']), expected_counts[selected[i]])
+            if doc['status'] == 'complete':
