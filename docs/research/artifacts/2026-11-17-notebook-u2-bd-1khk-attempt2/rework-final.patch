+#[test]
+fn ambiguous_group_repeated_anonymous_output_only() {
+    ambiguous_output_only(false);
+}
+
+#[test]
+fn ambiguous_group_duplicate_explicit_output_only() {
+    ambiguous_output_only(true);
+}
