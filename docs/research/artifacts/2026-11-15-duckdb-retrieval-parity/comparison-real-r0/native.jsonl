{"case_id":"real-read-extract_file_facts-0","tool":"code_read_symbol","args":{"context_lines":0,"name":"extract_file_facts","path":"crates/spur-graph/src/extract/tree_sitter.rs","response_format":"source"},"body":{"id":"398c9f6ebab14d21","name":"impl BytesExtractor::extract_file_facts","file":"crates/spur-graph/src/extract/tree_sitter.rs","range":{"start":369,"end":410},"source":"    pub fn extract_file_facts(\n        &mut self,\n        logical_path: &Path,\n        bytes: &[u8],\n    ) -> Result<GraphFacts, ExtractError> {\n        let logical_path = logical_path\n            .to_str()\n            .ok_or_else(|| ExtractError::Extraction(\"logical path must be UTF-8\".into()))?;\n        // Native fact paths use slash separators, including on Windows. Validate\n        // that spelling so a backslash cannot hide a root or parent component.\n        let logical_path = logical_path.replace('\\\\', \"/\");\n        let mut path = PathBuf::new();\n        for component in Path::new(&logical_path).components() {\n            match component {\n                Component::Normal(part) => path.push(part),\n                Component::CurDir => {}\n                _ => {\n                    return Err(ExtractError::Extraction(\n                        \"logical path must be relative with no parent components\".into(),\n                    ));\n                }\n            }\n        }\n        if path.as_os_str().is_empty() {\n            return Err(ExtractError::Extraction(\n                \"logical path must name a file\".into(),\n            ));\n        }\n        let path_bytes = path.as_os_str().as_encoded_bytes();\n        if path_bytes.first().is_some_and(u8::is_ascii_alphabetic)\n            && path_bytes.get(1) == Some(&b':')\n        {\n            return Err(ExtractError::Extraction(\n                \"logical path must not have a drive prefix\".into(),\n            ));\n        }\n\n        let mut builder = FactBuilder::new(Path::new(\"\"));\n        self.extract_graph_facts(&mut builder, &path, bytes)?;\n        builder.resolve_pending_edges();\n        Ok(builder.into_facts())\n    }\n","file_oid":"09476ea2c0d9b6dc6d16e4c9e81165edc4c97b1e"},"error":null,"elapsed_ns":106829042}
{"case_id":"real-read-extract_file_facts-2","tool":"code_read_symbol","args":{"context_lines":2,"name":"extract_file_facts","path":"crates/spur-graph/src/extract/tree_sitter.rs","response_format":"source"},"body":{"id":"398c9f6ebab14d21","name":"impl BytesExtractor::extract_file_facts","file":"crates/spur-graph/src/extract/tree_sitter.rs","range":{"start":367,"end":412},"source":"    /// pending-edge resolution considers only this file, so references needing\n    /// other files may remain unresolved with their native evidence intact.\n    pub fn extract_file_facts(\n        &mut self,\n        logical_path: &Path,\n        bytes: &[u8],\n    ) -> Result<GraphFacts, ExtractError> {\n        let logical_path = logical_path\n            .to_str()\n            .ok_or_else(|| ExtractError::Extraction(\"logical path must be UTF-8\".into()))?;\n        // Native fact paths use slash separators, including on Windows. Validate\n        // that spelling so a backslash cannot hide a root or parent component.\n        let logical_path = logical_path.replace('\\\\', \"/\");\n        let mut path = PathBuf::new();\n        for component in Path::new(&logical_path).components() {\n            match component {\n                Component::Normal(part) => path.push(part),\n                Component::CurDir => {}\n                _ => {\n                    return Err(ExtractError::Extraction(\n                        \"logical path must be relative with no parent components\".into(),\n                    ));\n                }\n            }\n        }\n        if path.as_os_str().is_empty() {\n            return Err(ExtractError::Extraction(\n                \"logical path must name a file\".into(),\n            ));\n        }\n        let path_bytes = path.as_os_str().as_encoded_bytes();\n        if path_bytes.first().is_some_and(u8::is_ascii_alphabetic)\n            && path_bytes.get(1) == Some(&b':')\n        {\n            return Err(ExtractError::Extraction(\n                \"logical path must not have a drive prefix\".into(),\n            ));\n        }\n\n        let mut builder = FactBuilder::new(Path::new(\"\"));\n        self.extract_graph_facts(&mut builder, &path, bytes)?;\n        builder.resolve_pending_edges();\n        Ok(builder.into_facts())\n    }\n\n    pub(crate) fn extract_graph_facts(\n","file_oid":"09476ea2c0d9b6dc6d16e4c9e81165edc4c97b1e","context_lines":2},"error":null,"elapsed_ns":106097250}
