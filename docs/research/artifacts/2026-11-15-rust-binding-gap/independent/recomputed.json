  {
    "name": "raw_counts",
    "sql": "SELECT count(*) AS calls,count(DISTINCT (logical_path,edge_id)) AS unique_keys,count(*) FILTER(WHERE target_node_id IS NULL) AS unresolved,count(*) FILTER(WHERE target_node_id IS NOT NULL) AS local_targets,100.0*count(*) FILTER(WHERE target_node_id IS NOT NULL)/count(*) AS local_target_pct FROM frozen.main.edges WHERE relation='calls' AND ends_with(logical_path,'.rs')",
    "params": [],
    "rows": [
      {
        "calls": 259828,
        "unique_keys": 259828,
        "unresolved": 227414,
        "local_targets": 32414,
        "local_target_pct": 12.475175885585848
      }
    ]
  },
  {
    "name": "hint_counts",
