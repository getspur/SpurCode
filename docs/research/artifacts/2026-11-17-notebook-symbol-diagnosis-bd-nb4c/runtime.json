      "key": "flat_noop_collision",
      "source": "-- Counterexample to blindly concatenating cell symbols into the existing file matcher.\n-- Both cells have a top-level helper; the unchanged notebook must have zero changes.\nWITH inputs AS (\n SELECT list_concat(\n   spur_graph_symbols('cell-a.py',$$def helper():\n    return 1\n$$),\n   spur_graph_symbols('cell-b.py',$$def helper():\n    return 2\n$$)) AS symbols\n), compared AS (\n SELECT symbols,spur_graph_symbol_changes('two-cells.ipynb','two-cells.ipynb','M',symbols,symbols) AS result\n FROM inputs\n)\nSELECT length(symbols) AS input_symbols, length(result.changes) AS unchanged_notebook_deltas,\n       list_transform(result.changes,lambda d: d.change_kind) AS change_kinds,\n       result.diagnostics\nFROM compared;"
    }
