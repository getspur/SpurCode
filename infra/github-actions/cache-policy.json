{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::spurlab-591950085580-spur-sccache-apse5"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::spurlab-591950085580-spur-sccache-apse5"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::spurlab-591950085580-spur-sccache-apse5/spur/*",
        "arn:aws:s3:::spurlab-591950085580-spur-sccache-apse5/spur-notebook/*"
      ]
    }
  ]
}
