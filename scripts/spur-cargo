#!/usr/bin/env bash
# spur-cargo — project-standard cargo wrapper.
#
# Remote is the DEFAULT for heavy compiles; lightweight subcommands auto-run
# local. Routing (by subcommand):
#   heavy  — build / check / test / doc / clean: dispatched to the centralized
#       cloud-build pipeline (scripts/cloud-build/build.sh, owned by the
#       standalone spur-notebook checkout) with AWS Malaysia primary, AWS Tokyo fallback, then
#       local cargo only if both clouds are unreachable. (clean is here so it
#       cleans the remote target, not the unused local one.)
#   cross  — zigbuild (macOS Mach-O, incl. universal2, plus lean static Linux
#       musl bootstraps) / xwin (Windows PE): heavy-class remote dispatch of
#       the cross toolchains provisioned on the build VM; each case below
#       injects its default --target and the env its toolchain needs. Together
#       with the native Linux target this is the full platform matrix —
#       `cargo xtask dist` drives all three.
#   lint   — clippy: auto-forced LOCAL by default (fast, incremental, no VM
#       round-trip). SPUR_REMOTE=1 forces it remote — use that in CI, or in a
#       sandboxed agent that cannot write the local target/ (EPERM on
#       provenance-tagged artifacts).
#   run    — run: REMOTE by default, like the heavy compiles. Running a binary
#       means compiling it first, which is a heavy workload that belongs on the
#       VM by design. It compiles AND executes on the VM (so a sandbox never pays
#       the heavy bundled-DuckDB compile locally), then build.sh syncs the
#       worktree file changes back so file-producing binaries (e.g. nango-import)
#       land their output locally. Caveat: the binary must write into the
#       worktree, not an out-of-tree path like /tmp — only worktree changes are
#       synced back. For an interactive run (TUI, a local server/port, anything
#       needing live stdin or localhost) use SPUR_REMOTE=0 to force it local.
#   e2e    — e2e: REMOTE by default. The VM builds `spur-cli` in debug mode,
#       runs scripts/e2e/run-all.sh from the private run dir, and syncs
#       scripts/e2e/.artifacts/ back before preserving the suite exit code.
#       SPUR_REMOTE=0 runs the local runner directly; it never builds implicitly.
#   embed  — graph-embed / embed / embedding: convenience shortcuts for
#       `run -p spur-cli -- graph embed --workspace ...`, so existing graph
#       artifacts are vector-filled remotely by default and synced back with
#       other run outputs.
#   local  — fmt / everything else: always local (remote is meaningless).
#
# Local execution injects scripts/sccache-worktree.sh as RUSTC_WRAPPER.
#
# Per-invocation overrides:
#   SPUR_REMOTE=0   → force local (any subcommand)
#   SPUR_REMOTE=1   → force remote (any compile-capable subcommand, incl.
#                     clippy and run; run additionally syncs outputs back)
#   SPUR_NO_LOCAL_FALLBACK=1 → when every remote cloud is unreachable, exit
#                     200 instead of falling back to local cargo. For CI
#                     (release-dist.yml): a local fallback would compile
#                     wrong-arch artifacts on the runner — failing fast is
#                     strictly better there.
#
# Wrapper options:
#   --workdir <dir> / --dir <dir> → run cargo from <dir>, resolved relative to
#                     the caller's current directory. Defaults to the caller's cwd.
#
# See: docs/rca/2026-04-27-sccache-worktree-cache-miss.md
#      scripts/cloud-build/ — centralized remote build pipeline
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="${SCRIPT_PATH%/*}"
[[ "$SCRIPT_DIR" == "$SCRIPT_PATH" ]] && SCRIPT_DIR="."
SCRIPT_DIR=$(cd "$SCRIPT_DIR" && pwd -P)
WRAPPER="$SCRIPT_DIR/sccache-worktree.sh"

resolve_remote_build_sh() {
    local candidate git_toplevel repo_root notebook_repo

    if [[ -n "${SPUR_CLOUD_BUILD_SH:-}" ]]; then
        [[ -x "$SPUR_CLOUD_BUILD_SH" ]] && { printf '%s\n' "$SPUR_CLOUD_BUILD_SH"; return 0; }
        return 1
    fi

    candidate="$SCRIPT_DIR/cloud-build/build.sh"
    [[ -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
    if [[ -L "$candidate" && ! -e "$candidate" ]]; then
        echo "[spur-cargo] WARNING: dangling cloud-build helper symlink: $candidate -> $(readlink "$candidate")" >&2
    fi

    if [[ -n "${SPUR_NOTEBOOK_REPO:-}" ]]; then
        candidate="$SPUR_NOTEBOOK_REPO/scripts/cloud-build/build.sh"
        [[ -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
    fi

    git_toplevel=$(git -C "$SCRIPT_DIR/.." rev-parse --show-toplevel 2>/dev/null || true)
    [[ -n "$git_toplevel" ]] || return 1
    if [[ "$git_toplevel" == *"/.spur/worktrees/"* ]]; then
        repo_root="$(dirname "$(dirname "$(dirname "$git_toplevel")")")"
    else
        repo_root="$git_toplevel"
    fi
    notebook_repo="$(dirname "$repo_root")/spur-notebook"
    candidate="$notebook_repo/scripts/cloud-build/build.sh"
    [[ -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }

    return 1
}

REMOTE_BUILD_SH="$(resolve_remote_build_sh || true)"

# ---- wrapper options -------------------------------------------------------
# Keep wrapper-specific flags out of Cargo's argv. Only leading wrapper options
# are consumed; once the first Cargo arg is seen, the rest is forwarded exactly.
ORIGINAL_PWD=$(pwd -P)
WORKDIR="$ORIGINAL_PWD"
CARGO_ARGV=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --workdir|--dir)
            if [[ $# -lt 2 || -z "${2:-}" ]]; then
                echo "[spur-cargo] --workdir/--dir requires a directory" >&2
                exit 2
            fi
            WORKDIR="$2"
            shift 2
            ;;
        --workdir=*|--dir=*)
            WORKDIR="${1#*=}"
            if [[ -z "$WORKDIR" ]]; then
                echo "[spur-cargo] --workdir/--dir requires a directory" >&2
                exit 2
            fi
            shift
            ;;
        *)
            CARGO_ARGV=("$@")
            break
            ;;
    esac
done
set -- "${CARGO_ARGV[@]}"

if [[ "$WORKDIR" != /* ]]; then
    WORKDIR="$ORIGINAL_PWD/$WORKDIR"
fi
if [[ ! -d "$WORKDIR" ]]; then
    echo "[spur-cargo] --workdir directory does not exist: $WORKDIR" >&2
    exit 2
fi
WORKDIR=$(cd "$WORKDIR" && pwd -P)
cd "$WORKDIR"

# ---- wrapper shortcut expansion -------------------------------------------
# Keep this as a thin argv rewrite so the existing `run` remote execution and
# sync-back contract remains the only implementation of remote file download.
case "${1:-}" in
    graph-embed|embed|embedding)
        shift
        DEFAULT_WORKSPACE=1
        for arg in "$@"; do
            case "$arg" in
                --root|--root=*|--workspace)
                    DEFAULT_WORKSPACE=0
                    ;;
            esac
        done
        if [[ $DEFAULT_WORKSPACE -eq 1 ]]; then
            set -- run -p spur-cli -- graph embed --workspace "$@"
        else
            set -- run -p spur-cli -- graph embed "$@"
        fi
        ;;
    coverage)
        # Two-phase, not a plain argv rewrite: the remote build VM syncs
        # git-tracked file *contents* only (via `git ls-files`, not a real
        # clone), so it has no branch history to diff against. Measure
        # (cargo-llvm-cov, heavy compile) goes through the normal `run`
        # remote-by-default dispatch; gate (git diff + threshold check,
        # cheap) always runs locally, where real git history exists.
        shift
        "$SCRIPT_DIR/spur-cargo" run -p xtask -- coverage --measure-only "$@"
        exec cargo run -p xtask -- coverage --gate-only "$@"
        ;;
    zigbuild)
        # cargo-zigbuild defaults to macOS cross-compile with the zig toolchain
        # and macOS SDK link stubs provisioned on the build VM (SDKROOT and
        # CFLAGS_aarch64_apple_darwin come from /etc/profile.d/spur-build.sh
        # there). Defaults to --target aarch64-apple-darwin since producing a
        # Mach-O binary is the whole point; pass an explicit --target to
        # override. Provider RUSTFLAGS (-Clinker=clang / -fuse-ld=lld /
        # neoverse-v2) are injected via `cargo --config`, which external
        # subcommands never see — exactly right for a darwin link driven by
        # zig. Fetch artifacts with scripts/cloud-build/fetch.sh, e.g.
        #   fetch.sh --via-s3 target/aarch64-apple-darwin/release/spur
        ZIG_TARGET=""
        PREV_ARG=""
        for arg in "$@"; do
            case "$PREV_ARG" in
                --target) ZIG_TARGET="$arg" ;;
            esac
            case "$arg" in
                --target=*) ZIG_TARGET="${arg#--target=}" ;;
            esac
            PREV_ARG="$arg"
        done
        if [[ -z "$ZIG_TARGET" ]]; then
            shift
            set -- zigbuild --target aarch64-apple-darwin "$@"
            ZIG_TARGET="aarch64-apple-darwin"
        fi
        # Provider aarch64-native RUSTFLAGS never belong in a cross link —
        # suppress the build.sh append path for every zigbuild target.
        export AWS_RUSTFLAGS_DEFAULT=""
        # The darwin link must stay in zig's hands. When the caller has no
        # RUSTFLAGS, build.sh injects the AWS provider defaults (-Clinker=clang
        # / -fuse-ld=lld / neoverse-v2) via `cargo --config`, which an external
        # subcommand never sees — harmless. But with RUSTFLAGS set, build.sh
        # APPENDS the provider defaults to the env value and they'd hijack the
        # Mach-O link, so suppress them at the source. RUSTFLAGS then carries
        # (a) force-frame-pointers, normally merged from .cargo/config.toml
        # build.rustflags, which an env RUSTFLAGS would otherwise drop, and
        # (b) `-framework CoreML`: pyke's prebuilt onnxruntime static lib
        # (ort-download-binaries) bundles the CoreML execution provider, but
        # ort-sys only emits that framework link when building ON a macOS
        # host, leaving a Linux cross link six _OBJC_CLASS_$_ML* symbols
        # short, and (c) the SDK's libc++.tbd as an explicit file: zig maps
        # `-lc++` to its own STATIC libc++/libc++abi, which puts a second C++
        # runtime in the process — natively-built DuckDB extension dylibs
        # (duckpgq etc., Apple clang + system libc++) then abort with
        # "libc++abi: terminating" the moment an exception crosses the
        # dlopen boundary, because the zig-side handlers can't match the
        # system-side exception. An explicit .tbd on the link line beats the
        # bundled static archive, so the binary links /usr/lib/libc++.1.dylib
        # exactly like a native build and shares one runtime with the
        # extensions, and (d) the final link runs through the VM's
        # clang+ld64.lld driver (provisioned by zigbuild-provision-vm.sh)
        # instead of zig's Mach-O linker: with libc++ as a dylib import,
        # zig's linker fails with "relocation Overflow" on the prebuilt
        # Apple-clang onnxruntime objects; ld64.lld links them like a native
        # toolchain would. rustc takes the LAST -C linker, so this cleanly
        # overrides the zig wrapper cargo-zigbuild configures — zig remains
        # the C/C++ compiler for all build-script compiles. Callers that set
        # RUSTFLAGS themselves own the full flag set.
        case "$ZIG_TARGET" in
            *apple-darwin*)
                if [[ -z "${RUSTFLAGS+x}" ]]; then
                    ZIGBUILD_LIBCXX_TBD="${SPUR_ZIGBUILD_LIBCXX_TBD:-/mnt/cargo/macsdk/MacOSX.sdk/usr/lib/libc++.tbd}"
                    ZIGBUILD_LINKER="${SPUR_ZIGBUILD_LINKER:-/mnt/cargo/macsdk/ld64-link.sh}"
                    export RUSTFLAGS="-Cforce-frame-pointers=yes -Clink-arg=-framework -Clink-arg=CoreML -Clink-arg=$ZIGBUILD_LIBCXX_TBD -Clinker=$ZIGBUILD_LINKER"
                fi
                ;;
            *-unknown-linux-musl*)
                # Lean static Lambda bootstraps have no C++/DuckDB ABI
                # boundary. Keep cargo-zigbuild for these targets so local
                # packaging can produce architecture-correct musl binaries.
                if [[ -z "${RUSTFLAGS+x}" ]]; then
                    export RUSTFLAGS="-Cforce-frame-pointers=yes"
                fi
                ;;
            *)
                # Non-darwin zigbuild target (x86_64-unknown-linux-gnu for
                # the npm linux-x64 dist leg): zig is the WRONG tool here —
                # its bundled libc++ cannot satisfy the libstdc++ symbols in
                # pyke's prebuilt GCC onnxruntime, and a libc++-built DuckDB
                # could not exchange exceptions with upstream libstdc++
                # extension .so's (the linux twin of the darwin libc++
                # story). Rewrite to a plain cargo build: the VM profile.d
                # exports target-scoped CC/CXX/AR/LINKER pointing at Debian's
                # real x86_64-linux-gnu cross GCC (sccache-wrapped), keeping
                # the whole binary on libstdc++ exactly like the old
                # cargo-dist runner builds.
                if [[ "${1:-}" == "zigbuild" ]]; then
                    shift
                    set -- build "$@"
                fi
                if [[ -z "${RUSTFLAGS+x}" ]]; then
                    # Env RUSTFLAGS overrides the repo config merge, so
                    # re-state force-frame-pointers explicitly.
                    export RUSTFLAGS="-Cforce-frame-pointers=yes"
                fi
                # The VM profile exports CFLAGS="-mcpu=native -O2" for the
                # aarch64 host; -mcpu=native is wrong for an x86_64 target
                # compile. A caller-set (non-empty) CFLAGS is re-exported by
                # build.sh AFTER profile.d, so a portable value here wins on
                # the VM (profile.d also sets target-scoped
                # CFLAGS_x86_64_unknown_linux_gnu as belt-and-suspenders).
                if [[ -z "${CFLAGS+x}" ]]; then export CFLAGS="-O2"; fi
                if [[ -z "${CXXFLAGS+x}" ]]; then export CXXFLAGS="-O2"; fi
                ;;
        esac
        ;;
    xwin)
        # Windows cross-compile: cargo-xwin drives clang-cl/lld-link (LLVM 19)
        # against the MSVC CRT + Windows SDK that xwin downloads into
        # XWIN_CACHE_DIR (/mnt/cargo/xwin via profile.d on the build VM,
        # XWIN_ACCEPT_LICENSE=1 set there too). Usage mirrors cargo's verbs:
        #   spur-cargo xwin build --release -p spur-cli
        # Defaults to --target x86_64-pc-windows-msvc (producing a PE .exe is
        # the whole point); pass an explicit --target to override. Fetch
        # artifacts with scripts/cloud-build/fetch.sh, e.g.
        #   fetch.sh --via-s3 target/x86_64-pc-windows-msvc/release/spur.exe
        # Unlike zigbuild, no custom RUSTFLAGS are needed — cargo-xwin sets up
        # compiler/linker env itself and the workspace .cargo/config.toml
        # (force-frame-pointers) still applies to its inner cargo. The one
        # hazard is build.sh APPENDING the aarch64-linux provider defaults
        # (-Ctarget-cpu=neoverse-v2 / -Clinker=clang) to a caller-set
        # RUSTFLAGS, which would poison the PE link — suppress them at the
        # source. (With RUSTFLAGS unset, provider defaults ride `cargo
        # --config`, which an external subcommand's inner cargo never sees.)
        export AWS_RUSTFLAGS_DEFAULT=""
        # The VM profile.d exports plain CFLAGS/CXXFLAGS="-mcpu=native -O2"
        # for native Graviton builds; cc-rs appends plain CFLAGS to every
        # compile and clang-cl hard-errors on -mcpu= for windows targets.
        # build.sh forwards a caller-set (non-empty) CFLAGS and re-exports it
        # AFTER sourcing profile.d, so a cl-safe value here wins on the VM.
        if [[ -z "${CFLAGS+x}" ]]; then export CFLAGS="-O2"; fi
        if [[ -z "${CXXFLAGS+x}" ]]; then export CXXFLAGS="-O2"; fi
        HAS_TARGET=0
        for arg in "$@"; do
            case "$arg" in
                --target|--target=*) HAS_TARGET=1 ;;
            esac
        done
        if [[ $HAS_TARGET -eq 0 ]]; then
            set -- "$@" --target x86_64-pc-windows-msvc
        fi
        ;;
esac

# ---- routing ---------------------------------------------------------------
# Remote is the default for heavy compiles; lightweight subcommands auto-run
# local. Precedence: an explicit SPUR_REMOTE wins; otherwise the subcommand
# class decides. See the header for the full contract.
SUBCOMMAND="${1:-}"
case "$SUBCOMMAND" in
    build|check|test|doc|zigbuild|xwin)
        CLASS="heavy" ;;
    clean)
        # clean must target wherever compilation happens. In remote mode the
        # artifacts live in /mnt/cargo on the VM, so `spur-cargo clean -p <pkg>`
        # has to run on the VM — otherwise it silently cleans the (unused) local
        # target dir and the remote stale artifact survives, masking real
        # staleness bugs. Falls back to local clean if the VM is unavailable.
        CLASS="heavy" ;;
    clippy)
        # Lightweight lint: auto-forced local for fast incremental feedback.
        CLASS="lint" ;;
    run)
        # Remote by default (compile is a heavy workload): the VM compiles +
        # executes the binary and build.sh syncs worktree outputs back.
        # SPUR_REMOTE=0 forces local for interactive runs (TUI/servers/ports).
        CLASS="run" ;;
    e2e)
        # Remote by default: the VM builds spur-cli, runs the TUI e2e suites,
        # and syncs failure artifacts back. SPUR_REMOTE=0 runs the local runner.
        CLASS="run" ;;
    *)
        # fmt and everything else: local only (remote is meaningless).
        CLASS="local" ;;
esac

REMOTE_CAPABLE=0
case "${SPUR_REMOTE:-}" in
    0)
        REMOTE_CAPABLE=0 ;;                                       # force local (any cmd)
    1)
        if [[ "$CLASS" != "local" ]]; then REMOTE_CAPABLE=1; fi ;; # force remote (not fmt/local-only)
    *)
        # default: heavy compiles AND run go remote (run = compile + execute).
        if [[ "$CLASS" == "heavy" || "$CLASS" == "run" ]]; then REMOTE_CAPABLE=1; fi ;;
esac

if [[ "$SUBCOMMAND" == "e2e" ]]; then
    rm -rf "$SCRIPT_DIR/e2e/.artifacts"
fi

# ---- remote dispatch -------------------------------------------------------
# build.sh exits with INFRA_UNAVAILABLE (200) only when the VM itself is
# unreachable; cargo's own exit codes (1/100/101 for build/test failures)
# pass through unchanged. We fall through AWS Malaysia -> AWS Tokyo -> local ONLY for 200 — a
# genuine test/build failure must propagate so the worker doesn't waste effort
# re-running elsewhere.
INFRA_UNAVAILABLE=200
if [[ $REMOTE_CAPABLE -eq 1 && -x "$REMOTE_BUILD_SH" ]]; then
    PRIMARY_CLOUD="${SPUR_CLOUD:-aws-my}"
    FALLBACK_CLOUD="${SPUR_CLOUD_FALLBACK-aws}"
    REMOTE_CLOUDS=("$PRIMARY_CLOUD")
    if [[ -n "$FALLBACK_CLOUD" && "$FALLBACK_CLOUD" != "$PRIMARY_CLOUD" ]]; then
        REMOTE_CLOUDS+=("$FALLBACK_CLOUD")
    fi

    for cloud in "${REMOTE_CLOUDS[@]}"; do
        echo "[spur-cargo] remote ($SUBCOMMAND) → $cloud VM" >&2
        set +e
        # Namespace defaults to "spur" (one shared warm target dir per
        # worktree). Callers may override — `cargo xtask dist --parallel`
        # gives each platform leg its own namespace so cargo's exclusive
        # target-dir lock doesn't serialize the concurrent legs.
        SPUR_REMOTE_NAMESPACE="${SPUR_REMOTE_NAMESPACE:-spur}" SPUR_CLOUD="$cloud" "$REMOTE_BUILD_SH" --auto-spin -- "$@"
        REMOTE_EXIT=$?
        set -e
        if [[ $REMOTE_EXIT -eq 0 ]]; then
            exit 0
        fi
        if [[ $REMOTE_EXIT -ne $INFRA_UNAVAILABLE ]]; then
            echo "[spur-cargo] remote cargo exited $REMOTE_EXIT on $cloud — propagating (not a VM-availability issue)" >&2
            exit $REMOTE_EXIT
        fi
        echo "[spur-cargo] remote $cloud VM unavailable (exit $REMOTE_EXIT) — trying next cloud/local" >&2
    done
    if [[ "${SPUR_NO_LOCAL_FALLBACK:-0}" == "1" ]]; then
        echo "[spur-cargo] all remote clouds unavailable — SPUR_NO_LOCAL_FALLBACK=1 forbids local fallback (exit $INFRA_UNAVAILABLE)" >&2
        exit "$INFRA_UNAVAILABLE"
    fi
    echo "[spur-cargo] all remote clouds unavailable — falling back to local cargo" >&2
elif [[ $REMOTE_CAPABLE -eq 1 && "${SPUR_NO_LOCAL_FALLBACK:-0}" == "1" ]]; then
    echo "[spur-cargo] AWS cloud-build helper unavailable; local fallback is disabled" >&2
    exit "$INFRA_UNAVAILABLE"
fi

# ---- local fallback (original behavior) ------------------------------------
if [[ "$SUBCOMMAND" == "e2e" ]]; then
    if [[ $# -gt 1 ]]; then
        echo "[spur-cargo] e2e does not accept cargo arguments; use SPUR_E2E_ONLY or SHELL_USE_RUNS" >&2
        exit 2
    fi
    exec "$SCRIPT_DIR/e2e/run-all.sh"
fi

use_spur_s3_sccache() {
    case "${SPUR_SCCACHE_S3-__spur_unset__}" in
        0|false|False|FALSE|no|No|NO|off|Off|OFF)
            return 1 ;;
        __spur_unset__)
            return 0 ;;
        *)
            return 0 ;;
    esac
}

# Restart the sccache server so it picks up the two-level disk,s3 config. The
# server reads the backend config once at start-server time, so a stale
# local-only daemon must be bounced.
ensure_spur_s3_sccache_server() {
    use_spur_s3_sccache || return 0
    [[ -z "${CODEX_SANDBOX:-}" ]] || return 0
    command -v sccache >/dev/null 2>&1 || return 0

    local stats
    # Text --show-stats reports the running server's backend reliably as
    # "Multi-level (N levels)" for disk,s3; the JSON format omits cache_location,
    # so match on text. If no server is running this probe auto-starts one with
    # the wrapper's multilevel env (already correct), and we no-op.
    stats=$("$WRAPPER" --show-stats 2>/dev/null || true)
    if [[ "$stats" == *"Multi-level"* && "$stats" == *"L0 (disk)"* && "$stats" == *"L1 (s3)"* ]]; then
        return 0
    fi

    if pgrep -f '/rustc[^ ]*$|/rustc ' >/dev/null 2>&1; then
        echo "[spur-cargo] S3 sccache requested but rustc is running; leaving existing sccache server unchanged" >&2
        return 0
    fi

    local error_log="${SCCACHE_ERROR_LOG:-/tmp/spur-sccache-s3.log}"
    "$WRAPPER" --stop-server >/dev/null 2>&1 || true
    if ! SCCACHE_ERROR_LOG="$error_log" "$WRAPPER" --start-server >/dev/null 2>&1; then
        sccache --start-server >/dev/null 2>&1 || true
        echo "[spur-cargo] failed to start S3 sccache server" >&2
        echo "[spur-cargo] see $error_log; verify AWS creds (aws sts get-caller-identity) and bucket region match SCCACHE_REGION" >&2
        exit 1
    fi
}


strip_sccache_compiler_prefix() {
    local value="$1"

    case "$value" in
        sccache\ *)
            printf '%s\n' "${value#sccache }" ;;
        */sccache\ *)
            printf '%s\n' "${value#*sccache }" ;;
        sccache-wrapper\ *)
            printf '%s\n' "${value#sccache-wrapper }" ;;
        */sccache-wrapper\ *)
            printf '%s\n' "${value#*sccache-wrapper }" ;;
        *)
            return 1 ;;
    esac
}

sanitize_codex_sandbox_sccache_env() {
    [[ -n "${CODEX_SANDBOX:-}" ]] || return 0

    case "${RUSTC_WRAPPER-}" in
        sccache|*/sccache|sccache-wrapper|*/sccache-wrapper)
            export RUSTC_WRAPPER="$WRAPPER" ;;
    esac

    # Worker sandboxes cannot run direct sccache clients. The Rust path is
    # handled by scripts/sccache-worktree.sh; strip inherited C/C++ wrappers so
    # build scripts using cc-rs invoke the real compiler instead.
    local env_name env_value stripped
    for env_name in \
        CC CXX HOST_CC HOST_CXX TARGET_CC TARGET_CXX \
        CC_aarch64_apple_darwin CXX_aarch64_apple_darwin \
        CC_x86_64_apple_darwin CXX_x86_64_apple_darwin \
        CC_aarch64_unknown_linux_gnu CXX_aarch64_unknown_linux_gnu \
        CC_x86_64_unknown_linux_gnu CXX_x86_64_unknown_linux_gnu
    do
        [[ -n "${!env_name+x}" ]] || continue
        env_value="${!env_name}"
        stripped=$(strip_sccache_compiler_prefix "$env_value") || continue
        export "$env_name=$stripped"
    done
}

if [[ -z "${RUSTC_WRAPPER+x}" ]]; then
    export RUSTC_WRAPPER="$WRAPPER"
fi
sanitize_codex_sandbox_sccache_env
# Incremental rustc invocations are non-cacheable; disable them so a remote
# S3 cache layer actually gets populated and hit.
if [[ -z "${CARGO_INCREMENTAL+x}" ]]; then
    if use_spur_s3_sccache; then
        export CARGO_INCREMENTAL=0
    fi
fi
# S3 takes precedence; only one remote backend is configured per invocation.
if use_spur_s3_sccache; then
    ensure_spur_s3_sccache_server
fi
exec cargo "$@"
